#: php/class-user-theme-options.php:139
msgid "Theme Options"
msgstr "Opzioni del tema"

#: php/class-user-theme-options.php:142
msgid "Themes"
msgstr "Temi"

#: php/class-user-theme-options.php:146
msgid "Enable Themes"
msgstr "Abilita Temi"

#: php/class-user-theme-options.php:149
msgid "This setting will allow user to edit themes."
msgstr "Questa impostazione consente all'utente di modificare i temi."

#: php/class-user-theme-options.php:154
msgid "Customizer"
msgstr "Personalizzazione"

#: php/class-user-theme-options.php:158
msgid "Enable Customize"
msgstr "Abilita personalizzazione"

#: php/class-user-theme-options.php:161
msgid "This setting will allow user to open customizer."
msgstr "Questa impostazione consente all'utente di personalizzare il tema."

#: php/class-user-theme-options.php:166
msgid "Widgets"
msgstr "Widget"

#: php/class-user-theme-options.php:170
msgid "Enable widgets"
msgstr "Abilita Widget"

#: php/class-user-theme-options.php:173
msgid "This setting will allow user to edit widgets."
msgstr "Questa impostazione consente all'utente di modificare i widget."

#: php/class-user-theme-options.php:178
msgid "Menu"
msgstr "Menu"

#: php/class-user-theme-options.php:182
msgid "Enable menus"
msgstr "Abilita Menu"

#: php/class-user-theme-options.php:185
msgid "This setting will allow user to edit menus."
msgstr "Questa impostazione consente all'utente di modificare i menu."

#: php/class-user-theme-options.php:190
msgid "Fonts"
msgstr "Font"

#: php/class-user-theme-options.php:194
msgid "Enable Fonts"
msgstr "Abilita Font"

#: php/class-user-theme-options.php:197
msgid "This setting will allow user to edit fonts."
msgstr "Questa impostazione consente all'utente di modificare i font."

#: php/class-user-theme-options.php:202
msgid "Patterns"
msgstr "Pattern"

#: php/class-user-theme-options.php:206
msgid "Enable Patterns"
msgstr "Abilita Pattern"

#: php/class-user-theme-options.php:209
msgid "This setting will allow user to edit patterns."
msgstr "Questa impostazione consente all'utente di modificare i pattern."

#. Description of the plugin/theme
msgid ""
"A WordPress plugin that allow to grant access permissions to Appearance menu."
msgstr ""
"Un plugin WordPress che consente di gestire gli accessi al menu Aspetto."
