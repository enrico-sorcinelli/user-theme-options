#: php/class-user-theme-options.php:117
msgid "Theme Options"
msgstr "Opzioni del tema"

#: php/class-user-theme-options.php:120
msgid "Themes"
msgstr "Temi"

#: php/class-user-theme-options.php:124
msgid "Enable Themes"
msgstr "Abilita Temi"

#: php/class-user-theme-options.php:127
msgid "This setting will allow user to edit themes."
msgstr "Questa impostazione consente all'utente di modificare i temi."

#: php/class-user-theme-options.php:132
msgid "Customizer"
msgstr "Personalizzazione"

#: php/class-user-theme-options.php:136
msgid "Enable Customize"
msgstr "Abilita personalizzazione"

#: php/class-user-theme-options.php:139
msgid "This setting will allow user to open customizer."
msgstr "Questa impostazione consente all'utente di personalizzare il tema."

#: php/class-user-theme-options.php:144
msgid "Widgets"
msgstr "Widget"

#: php/class-user-theme-options.php:148
msgid "Enable widgets"
msgstr "Abilita Widget"

#: php/class-user-theme-options.php:151
msgid "This setting will allow user to edit widgets."
msgstr "Questa impostazione consente all'utente di modificare i widget."

#: php/class-user-theme-options.php:156
msgid "Menu"
msgstr "Menu"

#: php/class-user-theme-options.php:160
msgid "Enable menus"
msgstr "Abilita Menu"

#: php/class-user-theme-options.php:163
msgid "This setting will allow user to edit menus."
msgstr "Questa impostazione consente all'utente di modificare i menu."

#. Description of the plugin/theme
msgid ""
"A WordPress plugin that allow to grant access permissions to Appearance menu."
msgstr ""
"Un plugin WordPress che consente di gestire gli accessi al menu Aspetto."
